# ─────────────────────────────────────────────────────────────
#  Vorlage: Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die .env wird durch .gitignore NIE auf GitHub hochgeladen.
#  Zu finden unter: developer.ebay.com → Application Keys (Production)
# ─────────────────────────────────────────────────────────────

# App ID (Client ID)
EBAY_APP_ID=

# Cert ID (Client Secret)
EBAY_CERT_ID=

# Dev ID
EBAY_DEV_ID=

# RuName (eBay Redirect URL name) – unter "User Tokens" → "Get a Token from eBay via Your Application"
EBAY_RUNAME=

# Nicht ändern
EBAY_ENV=production
EBAY_SITE_ID=77

# Claude (Titel & Beschreibungen) – console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
